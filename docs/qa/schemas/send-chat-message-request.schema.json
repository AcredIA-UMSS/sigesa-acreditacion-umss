{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigesa.umss.edu.bo/schemas/assistant/send-chat-message-request.json",
  "title": "SendChatMessageRequest",
  "description": "Cuerpo de POST /api/v1/assistant/chat — MOD-ASSISTANT SIGESA",
  "type": "object",
  "required": ["message"],
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1,
      "description": "Mensaje del usuario; validado por AssistantChatInputValidator (longitud, SQLi, XSS)."
    },
    "history": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["user", "assistant", "system", "tool"],
            "description": "Rol del mensaje en el historial."
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "context": {
      "type": ["object", "null"],
      "description": "Contexto del copiloto embebido (phases, users, evidence).",
      "properties": {
        "agent": {
          "type": "string",
          "enum": ["general", "phases", "users", "evidence"]
        },
        "processId": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "careerName": { "type": ["string", "null"] },
        "careerCode": { "type": ["string", "null"] },
        "templateType": { "type": ["string", "null"] },
        "userId": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "programId": {
          "type": ["string", "null"],
          "format": "uuid"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
