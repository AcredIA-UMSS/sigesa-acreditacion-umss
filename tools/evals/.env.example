# Misma base que red-team-agent / backend local
SIGESA_API_BASE=http://127.0.0.1:8080

# Opcional: default para ./run.sh capture / eval / gate (carpeta artifacts/responses/<VERSION>/)
# EVALS_PROMPT_VERSION=v2

# Juez LLM (Fase 6) — misma pila que el backend (recomendado: copiar del .env raíz)
#
# Perfil GROQ (backend SIGESA_ASSISTANT_BASE_URL → api.groq.com):
# SIGESA_JUDGE_BASE_URL=https://api.groq.com/openai/v1
# SIGESA_JUDGE_MODEL=openai/gpt-oss-20b
# SIGESA_JUDGE_API_KEY=   ← GROQ_API_KEY o SIGESA_ASSISTANT_API_KEY
#
# Perfil Open WebUI local (localhost:3001):
# SIGESA_JUDGE_BASE_URL=http://127.0.0.1:3001/api
# SIGESA_JUDGE_API_KEY=   ← API key de Open WebUI (NO la de Groq)
#
# Si omites SIGESA_JUDGE_* el CLI usa SIGESA_ASSISTANT_* / GROQ_* del .env raíz.
