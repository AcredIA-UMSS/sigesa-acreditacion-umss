# =============================================================================
# Agente E2E — config local (copiar a tools/e2e-agent/.env)
# También puede ir en .env de la raíz del monorepo (mismas claves SIGESA_E2E_*).
# =============================================================================

# --- IA local en Docker (recomendado para este proyecto) ---
SIGESA_E2E_PROVIDER=local

# Backend LLM cuando provider=local:
#   ollama      → http://localhost:11434/v1  (contenedor sigesa-ollama, sin API key)
#   open-webui  → http://localhost:3001/api/v1  (requiere SIGESA_ASSISTANT_API_KEY)
SIGESA_E2E_BACKEND=ollama

# Modelo en Ollama (debe estar descargado: docker exec sigesa-ollama ollama pull qwen2.5:7b)
SIGESA_E2E_MODEL=qwen2.5:7b

# Timeout por llamada (modelos locales son más lentos que Groq)
SIGESA_E2E_TIMEOUT_SECONDS=600

# --- Solo si SIGESA_E2E_BACKEND=open-webui ---
# SIGESA_E2E_BACKEND=open-webui
# SIGESA_ASSISTANT_API_KEY=sk-tu-api-key-de-open-webui
# SIGESA_E2E_MODEL=qwen2.5:7b

# --- Override manual (opcional) ---
# SIGESA_E2E_BASE_URL=http://localhost:11434/v1
# SIGESA_E2E_API_KEY=ollama

# --- Groq en la nube (alternativa) ---
# SIGESA_E2E_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# SIGESA_E2E_MODEL=openai/gpt-oss-20b
