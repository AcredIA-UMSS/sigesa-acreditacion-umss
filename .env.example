# Plantilla de variables de entorno - SIGESA
# Copiar este archivo a `.env` y configurar las claves necesarias para desarrollo local.

# Database Configuration (PostgreSQL)
POSTGRES_USER=sigesa_user
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=sigesa
DB_URL=jdbc:postgresql://db:5432/sigesa

# JWT Security Secret (Generar una clave Base64 segura en producción)
SIGESA_JWT_SECRET=your_jwt_secret_base64_encoded_key_here

# Assistant Virtual / LLM (Ollama & Open WebUI)
SIGESA_ASSISTANT_ENABLED=true
SIGESA_ASSISTANT_LLM_ENABLED=true
SIGESA_ASSISTANT_BASE_URL=http://localhost:3001
SIGESA_ASSISTANT_API_KEY=sk-your-open-webui-api-key-here
SIGESA_ASSISTANT_MODEL=qwen2.5:7b
SIGESA_ASSISTANT_RAG_ENABLED=true
SIGESA_ASSISTANT_RAG_MAX_CHUNKS=3
SIGESA_ASSISTANT_MAX_TOOL_ITERATIONS=5

# Frontend Configuration
VITE_API_URL=http://localhost:8080

# Modal trazabilidad copiloto fases (build-time). true = visible; false = oculto (recomendado prod).
VITE_PHASES_COPILOT_DEBUG_ACTIONS=false

# Modal trazabilidad copiloto usuarios (build-time).
VITE_USERS_COPILOT_DEBUG_ACTIONS=false

# Modal trazabilidad copiloto evidencias (build-time).
VITE_EVIDENCE_COPILOT_DEBUG_ACTIONS=false

# Badge «Modo desarrollo» en modal del asistente /ayuda (build-time).
VITE_ASSISTANT_DEBUG_ACTIONS=false
