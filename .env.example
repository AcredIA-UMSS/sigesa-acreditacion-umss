# =============================================================================
# SIGESA — Variables de entorno unificadas (host + Docker Compose)
# Copiar a `.env` en la raíz del repo. NO commitear `.env` (está en .gitignore).
# =============================================================================

# --- Runtime ---
# auto = detecta /.dockerenv | host = máquina local | docker = red compose
SIGESA_RUNTIME=auto

# --- Provider LLM compartido (assistant backend, test-generator, agents IDE) ---
# Valores: local (Ollama / Open WebUI) | groq
SIGESA_LLM_PROVIDER=local

# Cambiar provider solo para el generador de tests (opcional; vacío = hereda SIGESA_LLM_PROVIDER)
SIGESA_TESTGEN_PROVIDER=

# =============================================================================
# GROQ (https://console.groq.com) — provider=groq
# =============================================================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
SIGESA_LLM_MODEL_GROQ=openai/gpt-oss-20b
# Alternativas Groq (ago 2026+): openai/gpt-oss-120b | qwen/qwen3.6-27b
# Retirados en free/dev: llama-3.3-70b-versatile, llama-3.1-8b-instant

# =============================================================================
# LOCAL — provider=local (Ollama directo u Open WebUI)
# =============================================================================
SIGESA_LLM_MODEL_LOCAL=qwen2.5:7b

# URLs cuando corres en HOST (mvn spring-boot:run, ./tools/test-generator/run.sh)
SIGESA_ASSISTANT_BASE_URL_HOST=http://localhost:3001/api
SIGESA_LLM_BASE_URL_HOST=http://localhost:11434/v1

# URLs cuando corres en DOCKER (docker compose run test-generator, backend en compose)
SIGESA_ASSISTANT_BASE_URL_DOCKER=http://open-webui:8080/api
SIGESA_LLM_BASE_URL_DOCKER=http://ollama:11434/v1
# Si Ollama corre en el HOST y el generador en contenedor:
# SIGESA_LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1

# Red Docker Compose (para run-docker.sh; default: nombre_proyecto_default)
SIGESA_DOCKER_NETWORK=sigesa-acreditacion-umss_default

# =============================================================================
# Backend MOD-ASSISTANT (Spring Boot — copilotos /ayuda, chat API)
# El adapter usa API OpenAI-compatible (Open WebUI, Ollama o Groq).
#
# PERFIL LOCAL (default): Open WebUI + Ollama en compose
#   SIGESA_LLM_PROVIDER=local
#   SIGESA_ASSISTANT_BASE_URL → open-webui (docker) o localhost:3001 (host)
#   SIGESA_ASSISTANT_API_KEY  → API key de Open WebUI
#
# PERFIL GROQ (respuestas rápidas, sin Ollama):
#   SIGESA_LLM_PROVIDER=groq
#   SIGESA_ASSISTANT_BASE_URL=https://api.groq.com/openai
#   SIGESA_ASSISTANT_API_KEY=${GROQ_API_KEY}   (misma clave)
#   SIGESA_ASSISTANT_MODEL=openai/gpt-oss-20b
#   Nota: base-url SIN /v1 al final (Spring append /v1/chat/completions)
#
# Host: eval "$(./scripts/sigesa-env.sh)" resuelve según SIGESA_LLM_PROVIDER
# Docker: define SIGESA_ASSISTANT_* en .env (override de _DOCKER)
# =============================================================================
SIGESA_ASSISTANT_ENABLED=true
SIGESA_ASSISTANT_LLM_ENABLED=true
SIGESA_ASSISTANT_BASE_URL=http://localhost:3001/api
SIGESA_ASSISTANT_API_KEY=sk-your-open-webui-api-key-here
SIGESA_ASSISTANT_MODEL=qwen2.5:7b
SIGESA_ASSISTANT_RAG_ENABLED=true
SIGESA_ASSISTANT_RAG_MAX_CHUNKS=3
SIGESA_ASSISTANT_MAX_TOOL_ITERATIONS=5

# =============================================================================
# Test Generator AcredIA (tools/test-generator)
# =============================================================================
SIGESA_TESTGEN_TEMPERATURE=0
SIGESA_TESTGEN_MAX_TESTS=8
SIGESA_TESTGEN_MAX_TOKENS=4096
SIGESA_TESTGEN_MAX_RETRIES=1
SIGESA_TESTGEN_TIMEOUT_SECONDS=900
# compact = menos tokens (auto con groq) | full = más contexto (ollama local)
SIGESA_TESTGEN_PROMPT_MODE=
# Overrides opcionales (vacío = hereda según SIGESA_LLM_PROVIDER / SIGESA_RUNTIME)
SIGESA_TESTGEN_BASE_URL=
SIGESA_TESTGEN_API_KEY=
SIGESA_TESTGEN_MODEL=

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_USER=sigesa_user
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=sigesa
DB_URL=jdbc:postgresql://db:5432/sigesa

# JWT Security Secret (generar clave Base64 segura en producción)
SIGESA_JWT_SECRET=your_jwt_secret_base64_encoded_key_here

# =============================================================================
# Frontend (build-time Vite)
# =============================================================================
VITE_API_URL=http://localhost:8080
VITE_PHASES_COPILOT_DEBUG_ACTIONS=false
VITE_USERS_COPILOT_DEBUG_ACTIONS=false
VITE_EVIDENCE_COPILOT_DEBUG_ACTIONS=false
VITE_ASSISTANT_DEBUG_ACTIONS=false
